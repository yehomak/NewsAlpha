#!/usr/bin/env bash
# Blocks direct pushes to main/master. Use a feature branch and open a PR.
while read local_ref local_sha remote_ref remote_sha; do
    if echo "$remote_ref" | grep -qE '^refs/heads/(main|master)$'; then
        echo ""
        echo "  ✗ Direct push to main is blocked."
        echo "    Create a feature branch:  git checkout -b feat/<name>"
        echo "    Then open a PR:           gh pr create"
        echo ""
        exit 1
    fi
done
exit 0

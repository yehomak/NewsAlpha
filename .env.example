# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/butterfly_effect

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Langfuse — use https://cloud.langfuse.com or your self-hosted host
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Alpaca Markets (paper or live key both work for the news API)
ALPACA_KEY=
ALPACA_SECRET=

# App
LOG_LEVEL=INFO
APP_ENV=development

# Ingestion
INGEST_INTERVAL_HOURS=1
INGEST_MAX_AGE_DAYS=7

# Pipeline — keep PIPELINE_BATCH_SIZE small (5) during dev to control cost
PIPELINE_INTERVAL_MINUTES=30
PIPELINE_BATCH_SIZE=5
